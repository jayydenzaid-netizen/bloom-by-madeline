{%- comment -%}
  Esqueleto de la pantalla de «tienda protegida con contraseña».

  Es un layout aparte del principal a propósito: aquí no debe haber ni menú, ni
  carrito, ni enlaces a colecciones. Si la tienda está cerrada, todo eso serían
  puertas a un 404.
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_fondo | default: '#ECE1CD' }}">
    <title>{{ shop.name }}</title>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@300;400;500&family=Allura&display=swap">
    <link rel="stylesheet" href="{{ 'bloom.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'bloom-shopify.css' | asset_url }}">
    {{ content_for_header }}
  </head>
  <body class="plantilla-password">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <g id="lotus" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" fill="none">
          <path d="M60 88 C51 62 51.5 34 60 12 C68.5 34 69 62 60 88 Z"/>
          <path d="M60 88 C40 70 33 44 42 20 C56 36 61 62 60 88 Z"/>
          <path d="M60 88 C80 70 87 44 78 20 C64 36 59 62 60 88 Z"/>
          <path d="M60 88 C34 82 15 62 13 34 C36 42 54 62 60 88 Z"/>
          <path d="M60 88 C86 82 105 62 107 34 C84 42 66 62 60 88 Z"/>
          <path d="M18 95 C44 103 80 101 104 90" stroke-width="1.6" opacity=".8"/>
        </g>
      </defs>
    </svg>
    {{ content_for_layout }}
  </body>
</html>
