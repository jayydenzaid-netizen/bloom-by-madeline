{%- comment -%} Poner una contraseña nueva desde el enlace del correo. {%- endcomment -%}

<div class="shop-page section cuenta">
  <div class="cat-intro">
    <h1 class="cat-titulo">{{ 'cuenta.recuperar' | t }}</h1>
  </div>

  <div class="cuenta-form">
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <p class="co-err">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="co-field">
        <label class="co-label" for="clave-1">{{ 'cuenta.nueva_contrasena' | t }}</label>
        <input id="clave-1" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="co-field">
        <label class="co-label" for="clave-2">{{ 'cuenta.repetir_contrasena' | t }}</label>
        <input id="clave-2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button class="btn btn-ink" type="submit">{{ 'cuenta.restablecer' | t }}</button>
    {%- endform -%}
  </div>
</div>
