{%- comment -%}
  Tienda cerrada al público. Sirve mientras se prepara todo: el catálogo se puede
  ir montando y solo entra quien tenga la contraseña.
{%- endcomment -%}
{% layout 'password' %}

<div class="password-pantalla">
  <svg class="brand-lotus" viewBox="0 0 120 104" aria-hidden="true"><use href="#lotus"/></svg>

  <p class="footer-bloom">B&thinsp;L&thinsp;O&thinsp;O&thinsp;M</p>
  <p class="footer-by"><em>by</em> MADELINE</p>

  <h1 style="margin-top:24px">{{ 'password.titulo' | t }}</h1>
  <p style="max-width:44ch;color:var(--stone)">{{ 'password.texto' | t }}</p>

  {%- if settings.instagram != blank -%}
    <a class="btn btn-ink" href="https://www.instagram.com/{{ settings.instagram | remove: '@' }}/"
       target="_blank" rel="noopener">@{{ settings.instagram | remove: '@' }}</a>
  {%- endif -%}

  {%- form 'storefront_password', class: 'password-form' -%}
    {%- if form.errors -%}
      <p class="co-err" style="width:100%">{{ 'password.error' | t }}</p>
    {%- endif -%}
    <label class="visualmente-oculto" for="clave-tienda">{{ 'password.contrasena' | t }}</label>
    <input id="clave-tienda" type="password" name="password" placeholder="{{ 'password.contrasena' | t }}" autocomplete="off">
    <button class="btn btn-ghost btn-sm" type="submit">{{ 'password.entrar' | t }}</button>
  {%- endform -%}
</div>
