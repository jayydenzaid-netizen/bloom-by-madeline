# ─── Base de datos ───────────────────────────────────────────────────────────
# En desarrollo, SQLite en un fichero. En producción, la cadena de Postgres
# (Neon/Supabase) — el esquema ya está escrito para poder mudarse sin cambios.
DATABASE_URL="file:./dev.db"

# ─── Panel de administración ────────────────────────────────────────────────
# Al panel se entra con USUARIO y contraseña, no con el correo.
#
# ADMIN_USERNAME y ADMIN_PASSWORD se usan en dos momentos y solo en dos: al
# crear la cuenta la primera vez, y al ponerle usuario a una cuenta que venía de
# cuando se entraba por correo. Después la contraseña vive hasheada en la base
# de datos y estas dos variables ya no pintan nada.
#
# Ojo: los valores de verdad NO se escriben aquí. Este fichero se sube al
# repositorio, que es público. Van en el `.env` local (que no se sube) y en las
# variables del proyecto en Vercel.
ADMIN_USERNAME="elusuarioquequieras"
ADMIN_PASSWORD="unacontrasenalarga"
# El correo ya no sirve para entrar: se queda como contacto y para la bitácora.
ADMIN_EMAIL="madeline@bloombymadeline.com"
SESSION_SECRET="dev-secret-cambiar-en-produccion"

NEXT_PUBLIC_SITE_URL="http://localhost:4590"

# ─── Importador de proveedores (OPCIONAL) ───────────────────────────────────
# Sin estas llaves el importador sigue funcionando: usa el bookmarklet y el HTML
# pegado, que son las vías que no dependen de ninguna aprobación. Con ellas se
# habilita además la vía de API oficial, que es más cómoda y no se bloquea.
#
# AliExpress: alta en https://openservice.aliexpress.com — requiere aprobación
# como partner de dropshipping para el método aliexpress.ds.product.get.
ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""
#
# Alibaba.com: alta en https://open.alibaba.com — también requiere aprobación.
ALIBABA_APP_KEY=""
ALIBABA_APP_SECRET=""

# ─── Cobro online (Stripe / PayPal / Square) ────────────────────────────────
# Ya NO va por variables de entorno: Madeline pega las llaves de sus cuentas en
# el panel (/admin/pagos) y se guardan CIFRADAS en la base de datos con una
# clave derivada de SESSION_SECRET. Por eso SESSION_SECRET tiene que ser el
# mismo entre despliegues: si cambia, el panel pedirá pegar las llaves de nuevo.
# Mientras no haya ninguna pasarela conectada, el checkout ofrece pedido por DM
# y recogida en tienda, y la tarjeta aparece como «Próximamente». No se simula
# ningún cobro.

# ─── Shopify (para la mudanza y el importador) ──────────────────────────────
# El dominio INTERNO de la tienda, el que acaba en .myshopify.com. No sirve el
# dominio propio: el Admin API solo enruta por este.
SHOPIFY_STORE=""
#
# Token de una app privada con permisos de Admin API. Se saca así:
#   Panel → Configuración → Aplicaciones y canales de venta
#        → Desarrollar aplicaciones → Crear una aplicación
#        → Configuración de Admin API → marcar los permisos
#        → Instalar la aplicación → copiar el token (empieza por shpat_)
# OJO: al cambiar permisos hay que reinstalar, y el token CAMBIA.
SHOPIFY_ADMIN_TOKEN=""
#
# Versión del Admin API. Vacío = se autodetecta la más nueva estable, que es lo
# recomendable. Solo se fija a mano para reproducir un fallo concreto.
SHOPIFY_API_VERSION=""
