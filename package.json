{
  "name": "bloom-by-madeline",
  "version": "2.0.0",
  "private": true,
  "description": "Bloom by Madeline - tienda online con importador de proveedores",
  "scripts": {
    "dev": "next dev -p 4590",
    "build": "node scripts/db-provider.mjs && prisma generate && node scripts/preparar-bd.mjs && next build",
    "start": "next start -p 4590",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/db-provider.mjs && node scripts/migrar-usuario.mjs && prisma db push",
    "db:generate": "node scripts/db-provider.mjs && prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "test": "tsx --test tests/*.test.ts",
    "db:deploy": "node scripts/db-provider.mjs && node scripts/migrar-usuario.mjs && prisma db push --accept-data-loss",
    "desplegar": "node scripts/desplegar.mjs",
    "qa": "node --env-file-if-exists=.env qa/audit.mjs",
    "qa:compra": "node --env-file-if-exists=.env qa/compra.mjs",
    "qa:login": "node --env-file-if-exists=.env qa/login.mjs",
    "qa:pagos": "node --env-file-if-exists=.env qa/pagos.mjs",

    "shopify:verificar": "tsx shopify/verificar.ts",
    "shopify:prueba": "tsx shopify/verificar.ts --prueba",
    "shopify:importar": "tsx shopify/importar.ts",
    "shopify:puente": "tsx shopify/puente.ts",
    "shopify:migrar": "tsx shopify/migrar-catalogo.ts",
    "shopify:migrar:real": "tsx shopify/migrar-catalogo.ts --aplicar",

    "tema:construir": "node shopify/construir-tema.mjs",
    "tema:validar": "node shopify/validar-tema.mjs",
    "tema:zip": "node shopify/construir-tema.mjs --zip",
    "tema:vista": "node shopify/vista-previa.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "prisma": "^6.2.1",
    "puppeteer-core": "^25.8.0",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true
  }
}
