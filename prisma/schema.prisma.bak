// Bloom by Madeline — modelo de datos de la tienda.
//
// Reglas de la casa:
//  - TODO el dinero se guarda en CENTAVOS (Int). Nunca float: 0.1+0.2 no da 0.3.
//  - Nada de enum ni de arrays nativos: SQLite no los soporta y queremos poder
//    mover esto a Postgres sin reescribir el esquema. Los "enums" son String con
//    los valores permitidos documentados, y las listas van como JSON en un String.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── CATÁLOGO ───────────────────────────────

model Product {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String @default("")
  // draft | active | archived
  status      String @default("draft")
  vendor      String @default("Bloom by Madeline")
  productType String @default("")
  tagsJson    String @default("[]") // JSON: string[]

  // Nombres de las opciones de variante, en orden. JSON: ["Talla","Color"]
  optionNamesJson String @default("[]")

  // Precio de referencia: se recalcula desde la variante más barata al guardar.
  priceCents     Int  @default(0)
  compareAtCents Int? // precio tachado
  costCents      Int? // lo que le cuesta a la tienda (para calcular margen)

  // Trazabilidad del origen cuando el producto vino de un proveedor.
  sourceProvider  String? // aliexpress | alibaba | manual | csv
  sourceUrl       String?
  sourceProductId String?
  sourceDataJson  String? // volcado crudo de lo importado, por si hay que re-parsear

  seoTitle       String?
  seoDescription String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  images      ProductImage[]
  variants    ProductVariant[]
  collections CollectionProduct[]
  orderItems  OrderItem[]
  cartItems   CartItem[]

  @@index([status])
  @@index([sourceProvider, sourceProductId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String  @default("")
  position  Int     @default(0)
  // Si la imagen se descargó a /public, aquí queda la ruta local.
  localPath String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String

  title   String // "S / Negro"
  sku     String  @default("")
  option1 String? // Talla
  option2 String? // Color
  option3 String?

  priceCents     Int
  compareAtCents Int?
  costCents      Int?

  stock Int @default(0)
  // Si es false se puede vender sin stock: en dropshipping el inventario real
  // lo tiene el proveedor, no la boutique.
  trackStock Boolean @default(true)

  weightGrams Int     @default(0)
  imageUrl    String?
  position    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([productId, position])
}

model Collection {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String  @default("")
  imageUrl    String?
  position    Int     @default(0)
  isVisible   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

// ──────────────────────────────── CARRITO ────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  // Token que viaja en la cookie del visitante.
  token     String   @unique
  email     String?
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int    @default(1)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
}

// ──────────────────────────────── PEDIDOS ────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("")
  phone     String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())

  orders Order[]
}

model Order {
  id String @id @default(cuid())
  // Número legible para la clienta: BLM-1001
  number String @unique

  customerId String?
  email      String
  phone      String @default("")
  name       String

  // pending | paid | refunded | cancelled
  paymentStatus String @default("pending")
  // unfulfilled | fulfilled | cancelled
  fulfillStatus String @default("unfulfilled")
  // stripe | dm | pickup | cash
  paymentMethod String @default("dm")

  subtotalCents Int @default(0)
  shippingCents Int @default(0)
  taxCents      Int @default(0)
  discountCents Int @default(0)
  totalCents    Int @default(0)

  shipName    String @default("")
  shipLine1   String @default("")
  shipLine2   String @default("")
  shipCity    String @default("")
  shipState   String @default("")
  shipZip     String @default("")
  shipCountry String @default("US")

  note            String  @default("")
  trackingNumber  String?
  trackingCarrier String?

  stripeSessionId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  customer Customer?   @relation(fields: [customerId], references: [id])
  items    OrderItem[]

  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  // Se guardan también los datos "congelados" del producto: si mañana se borra
  // o cambia de precio, el pedido histórico debe seguir siendo legible.
  productId String?
  variantId String?

  title        String
  variantTitle String  @default("")
  sku          String  @default("")
  imageUrl     String?
  priceCents   Int
  costCents    Int?
  quantity     Int     @default(1)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

// ────────────────────────── IMPORTADOR / AJUSTES ──────────────────────────

model ImportJob {
  id String @id @default(cuid())
  // aliexpress | alibaba | manual | csv
  provider String
  // url | html | api | bookmarklet | csv
  method String
  // pending | parsing | ready | imported | failed
  status String @default("pending")

  sourceUrl String?
  // Ficha normalizada lista para revisar antes de publicar. JSON: NormalizedProduct
  draftJson String?
  rawJson   String?
  error     String?

  productId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String    @default("")
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
